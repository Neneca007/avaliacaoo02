export async function onRequestGet(context) {
  const { request, env, params } = context;
  const provider = params.provider; // "google" ou "github"
  const url = new URL(request.url);
  const code = url.searchParams.get("code");

  if (!code) {
    return new Response("Código de autorização não encontrado", { status: 400 });
  }

  // Aqui o seu código troca o 'code' pelo token do provider,
  // obtém os dados do utilizador, grava na tabela D1 e define o cookie de sessão.
  
  return Response.redirect(`${env.PUBLIC_BASE_URL || "https://avaliacaooo02.pages.dev"}/`, 302);
}
